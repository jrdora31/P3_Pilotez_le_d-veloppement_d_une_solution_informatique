{
  "name": "projet-3",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "backend:build": "npm run build --workspace backend",
    "backend:dev": "npm run start:dev --workspace backend",
    "backend:start": "npm run start --workspace backend",
    "backend:test": "npm run test --workspace backend",
    "backend:coverage": "npm run test:cov --workspace backend",
    "backend:test:e2e": "npm run test:e2e --workspace backend",
    "db:up": "docker start datashare-postgres",
    "db:down": "docker stop datashare-postgres",
    "db:logs": "docker logs -f datashare-postgres",
    "frontend:build": "npm run build --workspace frontend",
    "frontend:dev": "npm run dev --workspace frontend",
    "frontend:preview": "npm run preview --workspace frontend",
    "frontend:test": "npm run test --workspace frontend",
    "frontend:coverage": "npm run test:cov --workspace frontend",
    "swagger": "node scripts/serve-swagger.mjs",
    "openapi:lint": "npx @redocly/cli lint docs/OpenAPI/openapi.yaml"
  }
}
